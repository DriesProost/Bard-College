{
  "name": "bards-college",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit && npm run build:main && vite build",
    "test": "tsx --test tests/*.test.ts",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test:desktop": "npm run build && playwright test",
    "format": "prettier --write .",
    "pack:linux": "npm run build && electron-builder --linux --dir"
  },
  "dependencies": {
    "openai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "build": {
    "appId": "college.bards.desktop",
    "productName": "Bard's College",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "curriculum/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bard's College",
      "deleteAppDataOnUninstall": false,
      "script": "build/installer.nsi",
      "installerLanguages": [
        "en_US"
      ]
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "Bards-College-Setup-${version}-${arch}.${ext}",
    "asar": true,
    "linux": {
      "icon": "build/icon.png",
      "category": "Education"
    },
    "afterPack": "build/after-pack.cjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "description": "A local-first poetry and songwriting practice application.",
  "author": "Bard's College contributors"
}
